# Bootstrap password for a new admin account, or replacement for legacy admin/admin.
# Existing custom passwords remain managed through the account UI. Minimum 8 characters.
MANAGER_PASSWORD=

# Signs sessions and join tickets. Minimum 32 random characters.
# Without this, a random secret is generated at each startup and all sessions expire.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Keep the fork's registration workflow; use false to disable new registrations.
# New registrations are quizmasters; admins can change roles.
ALLOW_SIGNUP=true

# Local development ports. Docker serves port 3000; change its published port in compose.yml.
WEB_PORT=3000
SOCKET_PORT=3001

# Trust X-Real-IP only behind your own reverse proxy. Compose enables this for nginx.
# Keep false when exposing the Node server directly.
TRUST_PROXY=false
